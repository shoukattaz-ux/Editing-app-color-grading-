{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/evp/blueprint-1.0.json",
  "title": "EVP editing blueprint v1.0",
  "type": "object",
  "required": [
    "blueprint_version",
    "operations"
  ],
  "properties": {
    "blueprint_version": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "source_video": {
          "type": "string",
          "description": "Informational only; the video is chosen in the app."
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "resolution": {
          "type": "string",
          "default": "source",
          "description": "'source' or 'WIDTHxHEIGHT' (even, 64..7680x4320)"
        },
        "fps": {
          "oneOf": [
            {
              "const": "source"
            },
            {
              "type": "number",
              "minimum": 1,
              "maximum": 120
            }
          ]
        },
        "format": {
          "enum": [
            "mp4",
            "mov"
          ]
        },
        "codec": {
          "enum": [
            "h264",
            "h265"
          ]
        },
        "crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 51
        },
        "video_bitrate": {
          "type": "string",
          "pattern": "^\\d{2,6}[kKmM]$"
        },
        "audio_bitrate": {
          "type": "string",
          "pattern": "^\\d{2,4}k$"
        },
        "preset": {
          "enum": [
            "ultrafast",
            "veryfast",
            "fast",
            "medium",
            "slow"
          ]
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "type": {
            "enum": [
              "image",
              "video",
              "lut"
            ]
          },
          "path": {
            "type": "string",
            "description": "Relative to the project folder (no '..'); absolute paths must be inside the project."
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "type": {
            "enum": [
              "chroma_key",
              "background_removal",
              "background_replacement",
              "color_grading",
              "video_enhancement",
              "text_overlay",
              "audio_gain",
              "face_tone_correction",
              "face_relighting",
              "ai_upscale"
            ]
          },
          "start": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^(\\d+:)?\\d{1,2}:\\d{1,2}(\\.\\d+)?$|^\\d+(\\.\\d+)?$"
              }
            ],
            "default": 0
          },
          "end": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^(\\d+:)?\\d{1,2}:\\d{1,2}(\\.\\d+)?$|^\\d+(\\.\\d+)?$"
              }
            ],
            "description": "Omit for 'until end of video'."
          },
          "parameters": {
            "type": "object"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "label": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "chroma_key"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "key_color": {
                      "description": "Colour to remove: '#rrggbb', 'green' or 'blue'.",
                      "type": "string",
                      "pattern": "^(#?[0-9a-fA-F]{6}|green|blue|black|white|red|gray|grey)$",
                      "default": "#00ff00"
                    },
                    "similarity": {
                      "description": "How close a pixel must be to the key colour to become transparent.",
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 1.0,
                      "default": 0.12
                    },
                    "blend": {
                      "description": "Soft transition between keyed and kept pixels.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.08
                    },
                    "spill_suppression": {
                      "description": "Remove green/blue colour cast from the subject's edges.",
                      "type": "boolean",
                      "default": true
                    },
                    "spill_strength": {
                      "description": "Despill mix strength.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.5
                    },
                    "edge_erode": {
                      "description": "Shrink the matte to remove fringe.",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10,
                      "default": 0
                    },
                    "edge_feather": {
                      "description": "Gaussian softening of the matte edge.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 20.0,
                      "default": 0.0
                    },
                    "background_color": {
                      "description": "Fill used when no background_replacement consumes this key.",
                      "type": "string",
                      "pattern": "^(#?[0-9a-fA-F]{6}|green|blue|black|white|red|gray|grey)$",
                      "default": "#000000"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "background_removal"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "description": "'ai' = person matting without green screen (downloads a 15 MB model on first use); 'chroma' = green/blue screen.",
                      "type": "string",
                      "enum": [
                        "chroma",
                        "ai"
                      ],
                      "default": "chroma"
                    },
                    "model": {
                      "description": "[ai] Matting model. rvm = Robust Video Matting (GPL-3.0), hair-level detail, temporally stable.",
                      "type": "string",
                      "enum": [
                        "rvm"
                      ],
                      "default": "rvm"
                    },
                    "detail": {
                      "description": "[ai] Network resolution. fast is the most robust on busy/patterned backgrounds; balanced/high resolve finer hair on plain backgrounds but are slower and can pick up background texture.",
                      "type": "string",
                      "enum": [
                        "fast",
                        "balanced",
                        "high"
                      ],
                      "default": "fast"
                    },
                    "matte_threshold": {
                      "description": "[ai] Alpha below this becomes fully transparent (removes faint background haze).",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 0.5,
                      "default": 0.03
                    },
                    "despeckle": {
                      "description": "[ai] Remove background blobs that are not connected to the person.",
                      "type": "boolean",
                      "default": true
                    },
                    "edge_color_fix": {
                      "description": "[ai] Replace old-background colour in soft hair edges with the model's estimated foreground colour (removes halos).",
                      "type": "boolean",
                      "default": true
                    },
                    "quality": {
                      "description": "[chroma] Higher = more edge processing.",
                      "type": "string",
                      "enum": [
                        "draft",
                        "standard",
                        "high"
                      ],
                      "default": "high"
                    },
                    "edge_refinement": {
                      "description": "[chroma] Erode + feather the matte edge.",
                      "type": "boolean",
                      "default": true
                    },
                    "key_color": {
                      "description": "Colour to remove: '#rrggbb', 'green' or 'blue'.",
                      "type": "string",
                      "pattern": "^(#?[0-9a-fA-F]{6}|green|blue|black|white|red|gray|grey)$",
                      "default": "#00ff00"
                    },
                    "similarity": {
                      "description": "How close a pixel must be to the key colour to become transparent.",
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 1.0,
                      "default": 0.12
                    },
                    "blend": {
                      "description": "Soft transition between keyed and kept pixels.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.08
                    },
                    "spill_suppression": {
                      "description": "Remove green/blue colour cast from the subject's edges.",
                      "type": "boolean",
                      "default": true
                    },
                    "spill_strength": {
                      "description": "Despill mix strength.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.5
                    },
                    "background_color": {
                      "description": "Fill used when no background_replacement consumes this removal.",
                      "type": "string",
                      "pattern": "^(#?[0-9a-fA-F]{6}|green|blue|black|white|red|gray|grey)$",
                      "default": "#000000"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "background_replacement"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "asset_id": {
                      "description": "Background asset. Omit to use `color`.",
                      "type": "string"
                    },
                    "color": {
                      "description": "Solid background if no asset_id.",
                      "type": "string",
                      "pattern": "^(#?[0-9a-fA-F]{6}|green|blue|black|white|red|gray|grey)$",
                      "default": "#000000"
                    },
                    "fit": {
                      "description": "",
                      "type": "string",
                      "enum": [
                        "cover",
                        "contain",
                        "stretch"
                      ],
                      "default": "cover"
                    },
                    "scale": {
                      "description": "Additional zoom on the background.",
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 4.0,
                      "default": 1.0
                    },
                    "offset_x": {
                      "description": "Horizontal shift as fraction of frame width.",
                      "type": "number",
                      "minimum": -1.0,
                      "maximum": 1.0,
                      "default": 0.0
                    },
                    "offset_y": {
                      "description": "Vertical shift as fraction of frame height.",
                      "type": "number",
                      "minimum": -1.0,
                      "maximum": 1.0,
                      "default": 0.0
                    },
                    "blur": {
                      "description": "Gaussian background blur (fake depth of field).",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 50.0,
                      "default": 0.0
                    },
                    "brightness": {
                      "description": "Background brightness to match the subject.",
                      "type": "number",
                      "minimum": -1.0,
                      "maximum": 1.0,
                      "default": 0.0
                    },
                    "saturation": {
                      "description": "Background saturation to match the subject.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 3.0,
                      "default": 1.0
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "color_grading"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "preset": {
                      "description": "Starting look; individual controls are applied on top.",
                      "type": "string",
                      "enum": [
                        "none",
                        "cinematic_teal_orange",
                        "warm_film",
                        "cool_blue",
                        "bleach_bypass",
                        "faded_matte",
                        "high_contrast_bw"
                      ],
                      "default": "none"
                    },
                    "exposure": {
                      "description": "Exposure compensation in stops.",
                      "type": "number",
                      "minimum": -3.0,
                      "maximum": 3.0,
                      "default": 0.0
                    },
                    "contrast": {
                      "description": "1.0 = unchanged.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 3.0,
                      "default": 1.0
                    },
                    "brightness": {
                      "description": "",
                      "type": "number",
                      "minimum": -1.0,
                      "maximum": 1.0,
                      "default": 0.0
                    },
                    "highlights": {
                      "description": "Lift (+) or pull down (-) highlights.",
                      "type": "number",
                      "minimum": -1.0,
                      "maximum": 1.0,
                      "default": 0.0
                    },
                    "shadows": {
                      "description": "Lift (+) or crush (-) shadows.",
                      "type": "number",
                      "minimum": -1.0,
                      "maximum": 1.0,
                      "default": 0.0
                    },
                    "whites": {
                      "description": "",
                      "type": "number",
                      "minimum": -1.0,
                      "maximum": 1.0,
                      "default": 0.0
                    },
                    "blacks": {
                      "description": "",
                      "type": "number",
                      "minimum": -1.0,
                      "maximum": 1.0,
                      "default": 0.0
                    },
                    "temperature": {
                      "description": "-100 cool (blue) ... +100 warm (orange).",
                      "type": "number",
                      "minimum": -100.0,
                      "maximum": 100.0,
                      "default": 0.0
                    },
                    "tint": {
                      "description": "-100 green ... +100 magenta.",
                      "type": "number",
                      "minimum": -100.0,
                      "maximum": 100.0,
                      "default": 0.0
                    },
                    "saturation": {
                      "description": "1.0 = unchanged.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 3.0,
                      "default": 1.0
                    },
                    "vibrance": {
                      "description": "",
                      "type": "number",
                      "minimum": -2.0,
                      "maximum": 2.0,
                      "default": 0.0
                    },
                    "gamma": {
                      "description": "",
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 5.0,
                      "default": 1.0
                    },
                    "lift": {
                      "description": "[r,g,b] shadow colour offset, each -1..1 (Lift/Gamma/Gain).",
                      "type": "array"
                    },
                    "gamma_rgb": {
                      "description": "[r,g,b] midtone colour offset, each -1..1.",
                      "type": "array"
                    },
                    "gain": {
                      "description": "[r,g,b] highlight colour offset, each -1..1.",
                      "type": "array"
                    },
                    "curve_master": {
                      "description": "Master curve control points [[x,y],...] in 0..1.",
                      "type": "array"
                    },
                    "curve_red": {
                      "description": "Red curve control points [[x,y],...] in 0..1.",
                      "type": "array"
                    },
                    "curve_green": {
                      "description": "Green curve control points [[x,y],...] in 0..1.",
                      "type": "array"
                    },
                    "curve_blue": {
                      "description": "Blue curve control points [[x,y],...] in 0..1.",
                      "type": "array"
                    },
                    "lut_asset_id": {
                      "description": "A .cube/.3dl LUT asset to apply.",
                      "type": "string"
                    },
                    "lut_intensity": {
                      "description": "Blend between graded-without-LUT and LUT.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 1.0
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "video_enhancement"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "denoise": {
                      "description": "hqdn3d strength.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.0
                    },
                    "sharpen": {
                      "description": "Unsharp-mask amount.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 2.0,
                      "default": 0.0
                    },
                    "stabilize": {
                      "description": "Single-pass deshake. Modest results; fully-featured stabilisation is not claimed.",
                      "type": "boolean",
                      "default": false
                    },
                    "stabilize_strength": {
                      "description": "Max shift in px searched by deshake.",
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 64,
                      "default": 16
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "text_overlay"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "description": "Text to draw (max 500 chars).",
                      "type": "string"
                    },
                    "font_size": {
                      "description": "",
                      "type": "integer",
                      "minimum": 8,
                      "maximum": 400,
                      "default": 48
                    },
                    "color": {
                      "description": "",
                      "type": "string",
                      "pattern": "^(#?[0-9a-fA-F]{6}|green|blue|black|white|red|gray|grey)$",
                      "default": "#ffffff"
                    },
                    "x": {
                      "description": "Horizontal anchor (fraction, centred).",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.5
                    },
                    "y": {
                      "description": "Vertical anchor (fraction, centred).",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.85
                    },
                    "box": {
                      "description": "Draw a translucent box behind the text.",
                      "type": "boolean",
                      "default": true
                    },
                    "box_opacity": {
                      "description": "",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.5
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "text"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "audio_gain"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "gain_db": {
                      "description": "",
                      "type": "number",
                      "minimum": -60.0,
                      "maximum": 24.0,
                      "default": 0.0
                    },
                    "fade_in": {
                      "description": "",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 30.0,
                      "default": 0.0
                    },
                    "fade_out": {
                      "description": "",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 30.0,
                      "default": 0.0
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "face_tone_correction"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "strength": {
                      "description": "Overall amount of the correction.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 1.0
                    },
                    "auto_exposure": {
                      "description": "Bring the face toward target_brightness, smoothly over time.",
                      "type": "boolean",
                      "default": true
                    },
                    "target_brightness": {
                      "description": "Desired median skin brightness (0..1) for auto exposure.",
                      "type": "number",
                      "minimum": 0.3,
                      "maximum": 0.8,
                      "default": 0.55
                    },
                    "auto_strength": {
                      "description": "How far auto exposure moves toward the target.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.7
                    },
                    "max_auto_ev": {
                      "description": "Largest automatic exposure change.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 2.0,
                      "default": 1.0
                    },
                    "exposure": {
                      "description": "Manual face exposure (added to the automatic one).",
                      "type": "number",
                      "minimum": -2.0,
                      "maximum": 2.0,
                      "default": 0.0
                    },
                    "warmth": {
                      "description": "Skin warmth: + warmer, - cooler.",
                      "type": "number",
                      "minimum": -100.0,
                      "maximum": 100.0,
                      "default": 0.0
                    },
                    "tint": {
                      "description": "Skin tint: + magenta, - green.",
                      "type": "number",
                      "minimum": -100.0,
                      "maximum": 100.0,
                      "default": 0.0
                    },
                    "saturation": {
                      "description": "Skin saturation (1 = unchanged).",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 2.0,
                      "default": 1.0
                    },
                    "skin_only": {
                      "description": "Colour changes only on skin (not beard, eyes, hair).",
                      "type": "boolean",
                      "default": true
                    },
                    "feather": {
                      "description": "Softness of the face region edge (relative to face size).",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.5
                    },
                    "detection_confidence": {
                      "description": "Face detector threshold. Lower finds small/turned faces but may misfire.",
                      "type": "number",
                      "minimum": 0.3,
                      "maximum": 0.95,
                      "default": 0.6
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "face_relighting"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "key_angle": {
                      "description": "Key light side: -90 frame-left, 0 front, +90 frame-right.",
                      "type": "number",
                      "minimum": -90.0,
                      "maximum": 90.0,
                      "default": -45.0
                    },
                    "key_elevation": {
                      "description": "Key light height (raises the bright side toward the forehead).",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 60.0,
                      "default": 20.0
                    },
                    "key_intensity": {
                      "description": "Key light strength (up to +1.5 EV on the lit side).",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.5
                    },
                    "fill": {
                      "description": "Lifts dark areas of the face (up to +1 EV).",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.3
                    },
                    "shadow_depth": {
                      "description": "Darkens the side away from the key for more contrast.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.0
                    },
                    "feather": {
                      "description": "Softness of the face region edge (relative to face size).",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.5
                    },
                    "detection_confidence": {
                      "description": "Face detector threshold. Lower finds small/turned faces but may misfire.",
                      "type": "number",
                      "minimum": 0.3,
                      "maximum": 0.95,
                      "default": 0.6
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "ai_upscale"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "model": {
                      "description": "general: fast real-world model (CPU friendly). quality: Real-ESRGAN x4plus, finest detail, ~12x slower (GPU recommended). quality_x2: native 2x x2plus model, best for 1.5-2x jobs. anime: cartoons/anime/flat graphics.",
                      "type": "string",
                      "enum": [
                        "general",
                        "quality",
                        "quality_x2",
                        "anime"
                      ],
                      "default": "general"
                    },
                    "grain": {
                      "description": "Re-add the source's own fine grain/noise so the result looks camera-made rather than painted.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.0
                    },
                    "quality": {
                      "description": "fast: when the output is at most 2x the source, the network runs on a half-size frame (about 4x faster). best: always full size.",
                      "type": "string",
                      "enum": [
                        "fast",
                        "best"
                      ],
                      "default": "fast"
                    },
                    "denoise": {
                      "description": "[general model] 0 keeps all texture (and noise); 1 removes noise strongly (smoother).",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.5
                    },
                    "strength": {
                      "description": "Blend with a classical Lanczos upscale; lower looks more natural.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 1.0
                    },
                    "temporal_stability": {
                      "description": "Motion-compensated smoothing of the AI detail between frames (removes shimmer). 0 = per-frame.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.6
                    },
                    "color_fidelity": {
                      "description": "Keep the original's colour/exposure/contrast exactly; the AI only adds fine detail.",
                      "type": "boolean",
                      "default": true
                    },
                    "face_detail": {
                      "description": "Amount of AI detail on faces (1 = same as elsewhere). Lower avoids plastic skin and redrawn features.",
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 0.8
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      }
    }
  }
}
