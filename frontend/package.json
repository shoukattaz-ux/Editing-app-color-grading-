    "e2e:restore": "node e2e/restore-gpu.cjs",
    "e2e:merge": "node e2e/merge.cjs",
    "e2e:media": "node e2e/media-bin.cjs",
    "e2e:master": "node e2e/master.cjs",
    "e2e:export": "node e2e/export-folder.cjs",
    "e2e:key": "node e2e/key-tools.cjs",
    "e2e:plate": "node e2e/clean-plate.cjs",
    "e2e:doctor": "node e2e/key-doctor.cjs",
    "e2e:camera": "node e2e/camera-match.cjs",
    "e2e:hair": "node e2e/hair-detail.cjs",
    "e2e:floor": "node e2e/floor-fx.cjs",
    "e2e:light": "node e2e/light-pattern.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
